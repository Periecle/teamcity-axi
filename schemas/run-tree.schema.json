{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teamcity-axi:run-tree:1.0",
  "type": "object",
  "properties": {
    "run": {
      "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Run"
    },
    "graph": {
      "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Graph"
    },
    "selection": {
      "type": "object",
      "properties": {
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxGraphReads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "graphReadAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "consistency": {
          "const": "best_effort_counts_and_pages"
        },
        "omittedTargets": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "depth",
        "maxNodes",
        "maxGraphReads",
        "graphReadAttempts",
        "omittedTargets",
        "consistency"
      ],
      "additionalProperties": false
    }
  },
  "required": ["run", "graph", "selection"],
  "additionalProperties": false
}
