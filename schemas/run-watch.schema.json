{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teamcity-axi:run-watch:1.0",
  "title": "Single-document exact-run watch",
  "type": "object",
  "properties": {
    "runId": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 30 },
    "run": { "anyOf": [{ "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Run" }, { "type": "null" }] },
    "outcome": { "enum": ["finished", "deadline", "vanished", "inaccessible", "unavailable"] },
    "check": {
      "type": "object",
      "properties": { "requested": { "type": "boolean" }, "passed": { "type": "boolean" } },
      "required": ["requested", "passed"],
      "additionalProperties": false
    },
    "polling": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 32 },
        "intervalMs": { "type": "integer", "minimum": 5000, "maximum": 1800000 },
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "consistency": { "const": "best_effort" }
      },
      "required": ["count", "intervalMs", "elapsedMs", "consistency"],
      "additionalProperties": false
    }
  },
  "required": ["runId", "run", "outcome", "check", "polling"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "check": { "properties": { "passed": { "const": true } }, "required": ["passed"] }
        }
      },
      "then": {
        "properties": {
          "outcome": { "const": "finished" },
          "run": {
            "type": "object",
            "properties": { "state": { "const": "finished" }, "result": { "const": "success" } },
            "required": ["state", "result"]
          }
        }
      }
    }
  ]
}
