{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teamcity-axi:queue-list:1.0",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "urn:teamcity-axi:domain:1.0#/$defs/QueueItem"
      }
    },
    "page": {
      "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Page"
    },
    "selection": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "jobId": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "providerReturned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4999
        },
        "scanLimit": {
          "const": 5000
        },
        "consistency": {
          "const": "best_effort_offset"
        },
        "meaning": {
          "const": "queued_executions"
        }
      },
      "additionalProperties": false,
      "required": [
        "projectId",
        "jobId",
        "pageSize",
        "providerReturned",
        "position",
        "scanLimit",
        "consistency",
        "meaning"
      ]
    },
    "emptyReason": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": ["items", "page", "selection"],
  "additionalProperties": false
}
