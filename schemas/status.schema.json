{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teamcity-axi:status:1.0",
  "title": "Bounded exact-checkout status",
  "type": "object",
  "properties": {
    "mode": { "enum": ["unconfigured", "configured"] },
    "checkout": {
      "type": "object",
      "properties": {
        "head": { "type": ["string", "null"], "maxLength": 256 },
        "branch": { "type": ["string", "null"], "maxLength": 4096 },
        "dirty": { "type": ["boolean", "null"] },
        "revision": { "type": ["string", "null"], "maxLength": 256 },
        "vcsRootId": { "type": ["string", "null"], "maxLength": 256 }
      },
      "required": ["head", "branch", "dirty"],
      "additionalProperties": false
    },
    "message": { "type": "string", "maxLength": 240 },
    "assessment": { "enum": ["passed", "failed", "in_progress", "unverified"] },
    "check": {
      "type": "object",
      "properties": { "requested": { "type": "boolean" }, "passed": { "type": "boolean" } },
      "required": ["requested", "passed"],
      "additionalProperties": false
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "jobId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "required": { "const": true },
          "availability": { "enum": ["available", "unavailable"] },
          "match": { "enum": ["exact", "different", "unverified"] },
          "assessment": { "enum": ["passed", "failed", "in_progress", "unverified"] },
          "run": {
            "anyOf": [{ "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Run" }, { "type": "null" }]
          },
          "activity": {
            "type": ["object", "null"],
            "properties": {
              "queued": { "type": "integer", "minimum": 0, "maximum": 20 },
              "running": { "type": "integer", "minimum": 0, "maximum": 20 },
              "scope": { "const": "returnedCandidates" }
            },
            "required": ["queued", "running", "scope"],
            "additionalProperties": false
          },
          "candidateCount": { "type": "integer", "minimum": 0, "maximum": 20 },
          "limitationCodes": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "maxLength": 80 },
            "uniqueItems": true
          }
        },
        "required": [
          "jobId",
          "required",
          "availability",
          "match",
          "assessment",
          "run",
          "activity",
          "candidateCount",
          "limitationCodes"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": { "assessment": { "const": "passed" } },
              "required": ["assessment"]
            },
            "then": {
              "properties": {
                "availability": { "const": "available" },
                "match": { "const": "exact" },
                "run": {
                  "type": "object",
                  "properties": {
                    "state": { "const": "finished" },
                    "result": { "const": "success" }
                  },
                  "required": ["state", "result"]
                },
                "limitationCodes": { "maxItems": 0 }
              }
            }
          }
        ]
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "requiredJobs": { "type": "integer", "minimum": 1, "maximum": 100 },
        "displayedJobs": { "type": "integer", "minimum": 1, "maximum": 5 },
        "observedJobs": { "type": "integer", "minimum": 0, "maximum": 5 },
        "complete": { "type": "boolean" },
        "candidateLimitPerJob": { "const": 20 },
        "scanLimit": { "const": 5000 },
        "ordering": { "const": "newest_run_id" },
        "historyComplete": { "const": false },
        "consistency": { "const": "best_effort" }
      },
      "required": [
        "requiredJobs",
        "displayedJobs",
        "observedJobs",
        "complete",
        "candidateLimitPerJob",
        "scanLimit",
        "ordering",
        "historyComplete",
        "consistency"
      ],
      "additionalProperties": false
    },
    "failedRunIds": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 30 },
      "uniqueItems": true
    }
  },
  "required": ["mode", "checkout"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "unconfigured" } }, "required": ["mode"] },
      "then": {
        "required": ["message"],
        "properties": {
          "assessment": false,
          "check": false,
          "jobs": false,
          "coverage": false,
          "failedRunIds": false
        }
      },
      "else": {
        "required": ["assessment", "check", "jobs", "coverage", "failedRunIds"],
        "properties": { "message": false, "checkout": { "required": ["revision", "vcsRootId"] } }
      }
    },
    {
      "if": {
        "properties": {
          "check": { "properties": { "passed": { "const": true } }, "required": ["passed"] }
        },
        "required": ["check"]
      },
      "then": {
        "properties": {
          "assessment": { "const": "passed" },
          "coverage": { "properties": { "complete": { "const": true } } },
          "checkout": {
            "properties": {
              "dirty": { "const": false },
              "head": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "minLength": 1 },
              "vcsRootId": { "type": "string", "minLength": 1 }
            }
          },
          "jobs": { "items": { "properties": { "assessment": { "const": "passed" } } } }
        }
      }
    }
  ]
}
