{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teamcity-axi:failure:1.0",
  "title": "teamcity-axi failure data 1.0",
  "type": "object",
  "properties": {
    "run": {
      "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Run"
    },
    "assessment": {
      "enum": ["not_failed", "in_progress", "failure_observed", "inconclusive"]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Finding"
      },
      "maxItems": 100
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "urn:teamcity-axi:domain:1.0#/$defs/SourceCoverage"
      },
      "maxItems": 900
    },
    "graph": {
      "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Graph"
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Change"
      },
      "maxItems": 100
    },
    "selection": {
      "type": "object",
      "properties": {
        "maxDiagnosedRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "diagnosedRunIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "omittedDiagnosedRuns": {
          "type": "integer",
          "minimum": 0
        },
        "graphReadAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "maxGraphReads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "omittedGraphTargets": {
          "type": "integer",
          "minimum": 0
        },
        "omittedFindings": {
          "type": "integer",
          "minimum": 0
        },
        "consistency": {
          "const": "best_effort"
        },
        "dependencyReferences": {
          "const": "unavailable"
        },
        "omittedChanges": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "maxDiagnosedRuns",
        "diagnosedRunIds",
        "omittedDiagnosedRuns",
        "graphReadAttempts",
        "maxGraphReads",
        "omittedGraphTargets",
        "omittedFindings",
        "consistency",
        "dependencyReferences",
        "omittedChanges"
      ],
      "additionalProperties": false
    }
  },
  "required": ["run", "assessment", "findings", "sources", "graph"],
  "additionalProperties": false
}
