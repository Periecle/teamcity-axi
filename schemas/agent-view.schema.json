{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teamcity-axi:agent-view:1.0",
  "type": "object",
  "properties": {
    "selection": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "jobId": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "poolId": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "meaning": {
          "enum": ["compatible_agents", "exact_agent"]
        }
      },
      "required": ["projectId", "jobId", "poolId", "meaning"],
      "additionalProperties": false
    },
    "agent": {
      "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Agent"
    }
  },
  "required": ["agent", "selection"],
  "additionalProperties": false
}
