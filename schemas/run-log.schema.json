{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teamcity-axi:run-log:1.0",
  "type": "object",
  "properties": {
    "run": {
      "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Run"
    },
    "mode": {
      "enum": ["tail", "failed"]
    },
    "sources": {
      "type": "object",
      "properties": {
        "problems": {
          "type": "object",
          "properties": {
            "availability": {
              "enum": ["available", "unavailable"]
            },
            "complete": {
              "type": "boolean"
            },
            "coverage": {
              "enum": ["unavailable", "bounded_page", "tail_window"]
            },
            "errorCode": {
              "type": "string"
            }
          },
          "required": ["availability", "complete", "coverage"],
          "additionalProperties": false
        },
        "tests": {
          "type": "object",
          "properties": {
            "availability": {
              "enum": ["available", "unavailable"]
            },
            "complete": {
              "type": "boolean"
            },
            "coverage": {
              "enum": ["unavailable", "bounded_page", "tail_window"]
            },
            "errorCode": {
              "type": "string"
            }
          },
          "required": ["availability", "complete", "coverage"],
          "additionalProperties": false
        },
        "log": {
          "type": "object",
          "properties": {
            "availability": {
              "enum": ["available", "unavailable"]
            },
            "complete": {
              "type": "boolean"
            },
            "coverage": {
              "enum": ["unavailable", "bounded_page", "tail_window"]
            },
            "errorCode": {
              "type": "string"
            }
          },
          "required": ["availability", "complete", "coverage"],
          "additionalProperties": false
        }
      },
      "required": ["problems", "tests", "log"],
      "additionalProperties": false
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          }
        },
        "required": ["id", "runId", "type", "description"],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string"
          },
          "result": {
            "enum": ["success", "failure", "ignored", "unknown"]
          },
          "testId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "durationMs": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "muted": {
            "type": ["boolean", "null"]
          },
          "ignored": {
            "type": ["boolean", "null"]
          },
          "details": {
            "type": "string"
          },
          "rawStatus": {
            "type": "string"
          }
        },
        "required": ["id", "runId", "name", "result", "muted", "ignored"],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "text": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "status": {
            "type": "integer"
          },
          "timestamp": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "required": ["id", "runId", "text", "level", "status"],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "window": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "tail"
        },
        "requested": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "providerReturned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1001
        },
        "retained": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "firstMessageId": {
          "type": ["string", "null"]
        },
        "lastMessageId": {
          "type": ["string", "null"]
        },
        "omittedProviderMessages": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "contains": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "requested",
        "providerReturned",
        "retained",
        "firstMessageId",
        "lastMessageId",
        "omittedProviderMessages",
        "matched"
      ],
      "additionalProperties": false
    },
    "emptyReason": {
      "type": "string"
    }
  },
  "required": ["run", "mode"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "tail"
          }
        }
      },
      "then": {
        "required": ["messages", "window"]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": ["sources"]
      }
    }
  ]
}
