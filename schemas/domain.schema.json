{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teamcity-axi:domain:1.0",
  "title": "teamcity-axi core domain 1.0",
  "$defs": {
    "NextAction": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 240
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "minItems": 2,
          "maxItems": 30,
          "prefixItems": [
            {
              "const": "teamcity-axi"
            }
          ]
        }
      },
      "required": ["reason", "argv"],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 30
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "enum": ["queued", "running", "finished", "unknown"]
        },
        "result": {
          "enum": ["success", "failure", "error", "canceled", "failed_to_start", "unknown"]
        },
        "number": {
          "type": "string"
        },
        "branch": {
          "type": ["string", "null"]
        },
        "statusText": {
          "type": "string"
        },
        "personal": {
          "type": ["boolean", "null"]
        },
        "composite": {
          "type": ["boolean", "null"]
        },
        "queuedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "startedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "finishedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "durationMs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "webUrl": {
          "type": ["string", "null"]
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "vcsRootId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": ["vcsRootId", "revision"],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "rawStatus": {
          "type": ["string", "null"]
        }
      },
      "required": ["id", "jobId", "state", "result"],
      "additionalProperties": false
    },
    "Page": {
      "type": "object",
      "properties": {
        "returned": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "totalKind": {
          "enum": ["exact", "lower_bound", "unknown"]
        },
        "hasMore": {
          "type": ["boolean", "null"]
        },
        "cursor": {
          "type": ["string", "null"],
          "maxLength": 4096
        }
      },
      "required": ["returned", "total", "totalKind", "hasMore", "cursor"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "totalKind": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "total": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "totalKind": {
                "enum": ["exact", "lower_bound"]
              }
            }
          },
          "then": {
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "Limitation": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "maxLength": 1200
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 30
        },
        "source": {
          "enum": [
            "run",
            "problems",
            "tests",
            "log",
            "changes",
            "dependencies",
            "context",
            "output"
          ]
        },
        "details": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 0
            },
            "observed": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "SourceCoverage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 30
        },
        "kind": {
          "enum": ["run", "problems", "tests", "log", "changes", "dependencies"]
        },
        "state": {
          "enum": ["complete", "partial", "unavailable", "not_requested", "budget_exhausted"]
        },
        "returned": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "total": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "runId", "kind", "state"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": ["unavailable", "budget_exhausted"]
              }
            }
          },
          "then": {
            "required": ["reasonCode"]
          }
        }
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 30
        },
        "kind": {
          "enum": ["problem", "test", "log", "revision", "run"]
        },
        "itemId": {
          "type": ["string", "null"]
        },
        "excerpt": {
          "type": "string",
          "maxLength": 8192
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "retrieve": {
          "$ref": "urn:teamcity-axi:domain:1.0#/$defs/NextAction"
        }
      },
      "required": ["id", "sourceRef", "runId", "kind", "excerpt", "observedAt", "retrieve"],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 30
        },
        "kind": {
          "enum": [
            "failed_test",
            "build_problem",
            "dependency_failure",
            "log_signal",
            "revision_difference"
          ]
        },
        "claim": {
          "enum": ["observation", "hypothesis"]
        },
        "summary": {
          "type": "string",
          "maxLength": 1200
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Evidence"
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": ["id", "runId", "kind", "claim", "summary", "evidence"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "claim": {
                "const": "hypothesis"
              }
            }
          },
          "then": {
            "required": ["uncertainty"]
          }
        }
      ]
    },
    "GraphNode": {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "urn:teamcity-axi:domain:1.0#/$defs/Run"
        },
        "expansion": {
          "enum": [
            "complete",
            "not_requested",
            "depth_limit",
            "node_limit",
            "call_limit",
            "permission_denied",
            "unavailable"
          ]
        },
        "dependencyCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "observedDependencies": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "required": ["run", "expansion"],
      "additionalProperties": false
    },
    "Graph": {
      "type": "object",
      "properties": {
        "rootRunId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 30
        },
        "complete": {
          "type": "boolean"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "urn:teamcity-axi:domain:1.0#/$defs/GraphNode"
          },
          "maxItems": 200
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fromRunId": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "maxLength": 30
              },
              "toRunId": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "maxLength": 30
              },
              "kind": {
                "const": "snapshot"
              }
            },
            "required": ["fromRunId", "toRunId", "kind"],
            "additionalProperties": false
          },
          "maxItems": 2000
        },
        "unexpanded": {
          "type": "integer",
          "minimum": 0
        },
        "cycles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fromRunId": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "maxLength": 30
              },
              "toRunId": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "maxLength": 30
              },
              "kind": {
                "const": "snapshot"
              }
            },
            "required": ["fromRunId", "toRunId", "kind"],
            "additionalProperties": false
          },
          "maxItems": 2000
        }
      },
      "required": ["rootRunId", "complete", "nodes", "edges", "unexpanded"],
      "additionalProperties": false
    },
    "Change": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "vcsRootId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["id", "version", "vcsRootId", "message"],
      "additionalProperties": false
    }
  }
}
