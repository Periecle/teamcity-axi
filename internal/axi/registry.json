    {
      "name": "run.list",
      "summary": "Read one bounded scoped execution page",
      "flags": {
        "project": {
          "type": "string",
          "description": "Exact project ID"
        },
        "job": {
          "type": "string",
          "description": "Exact job ID"
        },
        "branch": {
          "type": "string",
          "description": "Logical branch or @this"
        },
        "literal-branch": {
          "type": "string",
          "description": "Literal logical branch"
        },
        "all-branches": {
          "type": "boolean",
          "description": "Include all logical branches"
        },
        "revision": {
          "type": "string",
          "description": "Commit identity or @head"
        },
        "vcs-root": {
          "type": "string",
          "description": "Exact VCS root ID"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum requested rows",
          "min": 1,
          "max": 100
        },
        "cursor": {
          "type": "string",
          "description": "Opaque bounded continuation"
        },
        "fields": {
          "type": "string",
          "description": "Comma separated public fields"
        },
        "state": {
          "type": "string",
          "description": "Lifecycle filter",
          "choices": [
            "queued",
            "running",
            "finished"
          ]
        },
        "result": {
          "type": "string",
          "description": "Outcome filter",
          "choices": [
            "success",
            "failure",
            "error",
            "canceled",
            "failed_to_start",
            "unknown"
          ]
        },
        "since": {
          "type": "string",
          "description": "RFC 3339 finish-time lower bound"
        },
        "until": {
          "type": "string",
          "description": "RFC 3339 finish-time upper bound"
        }
      },
      "fields": [
        "id",
        "jobId",
        "branch",
        "state",
        "result",
        "number",
        "statusText",
        "personal",
        "composite",
        "queuedAt",
        "startedAt",
        "finishedAt",
        "durationMs",
        "webUrl",
        "revisions"
      ]
    },
    {
      "name": "run.view",
      "summary": "Observe one exact execution",
      "positional": "runId",
      "flags": {
        "project": {
          "type": "string",
          "description": "Exact project ID"
        },
        "job": {
          "type": "string",
          "description": "Exact job ID"
        },
        "fields": {
          "type": "string",
          "description": "Comma separated public fields"
        },
        "full": {
          "type": "boolean",
          "description": "Expand text previews within budgets"
        }
      },
      "fields": [
        "id",
        "jobId",
        "branch",
        "state",
        "result",
        "number",
        "statusText",
        "personal",
        "composite",
        "queuedAt",
        "startedAt",
        "finishedAt",
        "durationMs",
        "webUrl",
        "revisions"
      ]
    },
