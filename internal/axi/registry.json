        },
        "all-branches": {
          "type": "boolean",
          "description": "Include all logical branches"
        },
        "revision": {
          "type": "string",
          "description": "Commit identity or @head"
        },
        "vcs-root": {
          "type": "string",
          "description": "Exact VCS root ID"
        },
        "check": {
          "type": "boolean",
          "description": "Assert completed successful exact checkout"
        }
      }
    },
