  "globalFlags": {
    "help": {
      "type": "boolean",
      "description": "Show local command help"
    },
    "version": {
      "type": "boolean",
      "description": "Show application version"
    },
    "format": {
      "type": "string",
      "description": "Output serialization",
      "choices": [
        "toon",
        "json"
      ]
    },
    "json": {
      "type": "boolean",
      "description": "Alias for --format json"
    },
    "server": {
      "type": "string",
      "description": "Registered trusted server alias"
    },
    "cwd": {
      "type": "string",
      "description": "Resolve worktree context from this directory"
    },
    "timeout": {
      "type": "duration",
      "description": "Overall deadline (ms, s or m)",
      "min": 1,
      "max": 1800000
    },
    "max-bytes": {
      "type": "integer",
      "description": "Serialized stdout byte ceiling",
      "min": 2048,
      "max": 262144
    },
    "require-complete": {
      "type": "boolean",
      "description": "Fail if the requested answer is partial"
    },
    "no-hints": {
      "type": "boolean",
      "description": "Omit optional read suggestions"
    },
    "debug": {
      "type": "boolean",
      "description": "Redacted metadata on stderr"
    }
  }
